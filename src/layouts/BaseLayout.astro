---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import DAGBackground from "../components/DAGBackground.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
    title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(href: string) {
    if (href === '/') return currentPath === '/';
    return currentPath.startsWith(href);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - Nymph</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
</head>
<body>
    <div class="dag-bg">
        <DAGBackground />
    </div>
    <header>
        <div class="header-bar">
            <div class="header-top">
                <a href="https://github.com/rhizonymph" target="_blank" class="social-icon" aria-label="GitHub">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                </a>
                <img src="/avatar.webp" alt="Profile Picture" class="profile-pic" width="48" height="48">
                <a href="https://twitter.com/rhizonymph" target="_blank" class="social-icon" aria-label="X/Twitter">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
            </div>
        </div>
    </header>

    <div class="container">
        <nav class="main-nav">
            <ul>
                <li><a href="/" class={isActive('/') ? 'active' : ''}>Bio</a></li>
                <li><a href="/blog/" class={isActive('/blog/') ? 'active' : ''}>Blog</a></li>
                <li><a href="/portfolio/" class={isActive('/portfolio/') ? 'active' : ''}>Code Portfolio</a></li>
            </ul>
        </nav>
        <main>
            <slot />
        </main>
    </div>

    <footer>
        
    </footer>
    
</body>
</html>

<style is:global>
    .dag-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        filter: blur(2px);
        will-change: filter;
        pointer-events: none;
    }

    header {
        position: relative;
        z-index: 1;
        background-image: url('/reaction-diffusion.webp');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 6px 0;
    }

    .header-bar {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4px 20px;
    }

    .header-top {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .profile-pic {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
    }

    .social-icon {
        color: #ffffff;
        font-size: 22px;
        transition: color 0.3s ease;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
    }

    .social-icon:hover {
        color: #bbbbbb;
        text-decoration: none;
    }

    .main-nav {
        width: 100%;
        display: flex;
    }

    .main-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 2px;
    }

    .main-nav li {
        text-align: center;
    }

    .main-nav a {
        color: #aaa;
        text-decoration: none;
        font-weight: bold;
        display: block;
        padding: 10px 20px;
        border-radius: 5px 5px 0 0;
        transition: background-color 0.3s ease, color 0.3s ease;
        white-space: nowrap;
        background-color: rgba(30, 30, 30, 0.6);
    }

    .main-nav a:hover {
        color: #fff;
        background-color: rgba(42, 42, 42, 0.5);
    }

    .main-nav a.active {
        color: #fff;
        background-color: rgba(42, 42, 42, 0.7);
    }

    .container {
        flex-grow: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        position: relative;
        z-index: 1;
    }

    main {
        background-color: rgba(42, 42, 42, 0.8);
        padding: 20px;
        border-radius: 0 5px 5px 5px;
    }

    footer {
        background-color: #333;
        color: #ccc;
        text-align: center;
        padding: 10px 0;
        margin-top: auto;
        font-size: 0.8em;
        position: relative;
        z-index: 1;
    }

    @media (max-width: 768px) {
        .main-nav ul {
            flex-wrap: wrap;
        }

        .main-nav a {
            padding: 8px 14px;
            font-size: 0.95em;
        }

        .container {
            padding: 12px;
        }

        main {
            padding: 16px;
            border-radius: 0 0 5px 5px;
        }
    }
</style>
