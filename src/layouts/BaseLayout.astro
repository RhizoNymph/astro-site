---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import DAGBackground from "../components/DAGBackground.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - Nymph</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Favicon link (assuming you have favicon.svg in public/) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Add other head elements like meta tags if needed -->
</head>
<body>
    <div class="dag-bg">
        <DAGBackground />
    </div>
    <header>
        <div class="header-bar">
            <div class="header-top">
                <a href="https://github.com/rhizonymph" target="_blank" class="social-icon"><i class="fab fa-github"></i></a>
                <img src="https://avatars.githubusercontent.com/u/82485126?s=400&u=c7c677bcb0633a255e0da7a4e97165d8cfba745b&v=4" alt="Profile Picture" class="profile-pic">
                <a href="https://twitter.com/rhizonymph" target="_blank" class="social-icon"><i class="fab fa-x-twitter"></i></a>
            </div>
            <nav class="main-nav">
                <ul>
                    <li><a href="/">Bio</a></li>
                    <li><a href="/blog/">Blog</a></li>
                    <li><a href="/portfolio/">Code Portfolio</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <div class="container">
        <main>
            <slot />
        </main>
    </div>

    <footer>
        
    </footer>
    
    <script>
        // Highlight active navigation link
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('.main-nav a');

        navLinks.forEach(link => {
            const linkPath = link.getAttribute('href');
            // Handle exact match for homepage and partial match for others
            if ((currentPath === '/' && linkPath === '/') || (linkPath !== '/' && currentPath.startsWith(linkPath))) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>

<style is:global>
    .dag-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        filter: blur(2px);
        pointer-events: none;
    }

    header {
        position: relative;
        z-index: 1;
        background-image: url('/reaction-diffusion.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 10px 0;
    }

    .header-bar {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
    }

    .header-top {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .profile-pic {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
    }

    .social-icon {
        color: #ffffff;
        font-size: 22px;
        transition: color 0.3s ease;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
    }

    .social-icon:hover {
        color: #bbbbbb;
        text-decoration: none;
    }

    .main-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
    }

    .main-nav li {
        flex: 1;
        text-align: center;
    }

    .main-nav {
        width: 100%;
        max-width: 400px;
        padding-left: 20px;
    }

    .main-nav a {
        color: #ffffff;
        text-decoration: none;
        font-weight: bold;
        display: block;
        padding: 10px 16px;
        border-radius: 4px;
        transition: background-color 0.3s ease;
        white-space: nowrap;
        background-color: #333;
    }

    .main-nav a:hover,
    .main-nav a.active {
        background-color: #3a3a3a;
    }

    .container {
        flex-grow: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        position: relative;
        z-index: 1;
    }

    main {
        background-color: rgba(42, 42, 42, 0.7);
        padding: 20px;
        border-radius: 5px;
    }

    footer {
        background-color: #333;
        color: #ccc;
        text-align: center;
        padding: 10px 0;
        margin-top: auto;
        font-size: 0.8em;
        position: relative;
        z-index: 1;
    }

    @media (max-width: 768px) {
        .main-nav ul {
            flex-wrap: wrap;
        }

        .main-nav a {
            padding: 10px 14px;
            font-size: 0.95em;
        }

        .container {
            padding: 12px;
        }

        main {
            padding: 16px;
        }
    }
</style>
